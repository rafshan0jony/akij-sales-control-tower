# Sync Bridge configuration
# Copy to the project root `.env` (the bridge reads the same `.env` as the app).

# --- DWH connection (same as the app) ---
MSSQL_SERVER=203.202.241.211
MSSQL_PORT=1433
MSSQL_USER=mcp_user
MSSQL_PASSWORD=CHANGE_ME
MSSQL_DATABASE=DWH
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# --- Bridge target ---
# The deployed app URL (Vercel), WITHOUT trailing slash.
SYNC_TARGET_URL=https://your-app.vercel.app

# Shared secret — MUST match SYNC_SECRET on the deployed app.
SYNC_SECRET=change-me-to-a-long-random-string

# How far back to sync, and how often (ms).
SYNC_LOOKBACK_DAYS=730
SYNC_INTERVAL_MS=300000
