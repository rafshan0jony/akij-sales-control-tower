# ============================================================
# Akij Sales Analytics - environment configuration
# Copy to `.env` and adjust values for your deployment.
# NEVER commit the real `.env` file.
# ============================================================

# --- Server ---
PORT=8080
NODE_ENV=production

# --- Application identity ---
APP_COMPANY="Akij Essentials Ltd."
APP_CHANNEL="Rice Bulk"
APP_CHANNEL_ID=145

# --- Data source: MCP-backed SQL Server (DWH) ---
# The MCP server `mssql-test-server` is a thin wrapper over this SQL Server.
# This app talks to the same database directly through a dedicated data
# repository layer (UI code never touches SQL/MCP internals).
MSSQL_SERVER=203.202.241.211
MSSQL_PORT=1433
MSSQL_USER=mcp_user
MSSQL_PASSWORD=change-me
MSSQL_DATABASE=DWH
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_CONNECTION_TIMEOUT=15000
MSSQL_REQUEST_TIMEOUT=30000

# --- App database (internal metadata: users/roles/territories/audit/cache) ---
# node:sqlite (built-in). Default is a file next to the app.
APP_DB_PATH=./data/app.db

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- Sync / cache ---
SYNC_INTERVAL_MS=300000
SYNC_ENABLED=true
# Shared secret for the external sync bridge (used when the DWH is not
# reachable from the app host, e.g. Vercel). Must match the bridge's value.
SYNC_SECRET=change-me-sync-secret
# Bridge target (set only in the bridge environment, not on the app).
# SYNC_TARGET_URL=https://your-app.vercel.app
SYNC_LOOKBACK_DAYS=730

# --- Timezone / business calendar ---
APP_TIMEZONE=Asia/Dhaka
# Financial year start month (1=Jan ... 7=Jul). Bangladesh FY is July-June.
FINANCIAL_YEAR_START_MONTH=7
# Weekend days (0=Sunday .. 6=Saturday). Bangladesh weekend: Fri(5), Sat(6).
WEEKEND_DAYS=5,6

# --- Rate limiting (per-IP) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
